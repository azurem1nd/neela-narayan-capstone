# Copy to .env and fill in real values. Never commit the real .env file.

# Spotify app credentials, from https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# Must exactly match a redirect URI registered on the Spotify app.
# Local dev example:
SPOTIPY_REDIRECT_URI=http://127.0.0.1:5000/callback

# Random secret used to sign the Flask session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
